# Copy to .env.staging locally only. Never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=<staging-firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<staging-firebase-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<staging-firebase-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<staging-firebase-web-app-id>
NEXT_PUBLIC_AUTH_API_BASE_URL=https://<namespace>-<staging-space>.hf.space
NEXT_PUBLIC_APP_VERSION=0.1.0-staging
STAGING_HOSTING_TARGET=<staging-hosting-target>
STAGING_HOSTING_SITE_ID=<staging-hosting-site-id>
